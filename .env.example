# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres. Render dashboard -> your database -> "External Database URL".
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini (controllers/constructionAI.js, src/ai/geminiVision.js)
GOOGLE_API_KEY=

JWT_SECRET=
NODE_ENV=development
PORT=5000
